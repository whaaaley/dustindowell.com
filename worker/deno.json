{
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["npm:@cloudflare/workers-types"]
  },
  "tasks": {
    "dev": "wrangler dev",
    "login": "wrangler login",
    "whoami": "wrangler whoami",
    "deploy": "wrangler deploy --env prod",
    "types": "wrangler types",
    "type-check": "deno check src/"
  },
  "imports": {
    "@cloudflare/workers-types": "npm:@cloudflare/workers-types@^5.20260904.1",
    "wrangler": "npm:wrangler@^4.129.0"
  }
}
