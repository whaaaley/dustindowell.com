# Build artifacts and deps the image rebuilds itself.
node_modules
dist
.vite

# Old scratch tree, not part of the build.
_scratch-old

# VCS and editor metadata.
.git
.gitignore
.zed
.vscode

# Deno lockfile from a prior toolchain, unused by the npm build.
deno.lock

# Local env and secrets, never bake into an image.
.env
.env.*
.auth

# Test output and audits.
test-results
.audits

# Container/deploy config itself.
Dockerfile
.dockerignore
fly.toml

# Bundles and large incidental files.
*.bundle
*.tsbuildinfo
