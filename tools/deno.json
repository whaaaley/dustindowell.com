{
  "tasks": {
    "wordmark": "deno run --allow-read --allow-write --allow-env wordmark/wordmark.ts",
    "og": "deno run -A og/og.ts",
    "lighthouse": "deno run -A lighthouse/lighthouse.ts",
    "test": "deno test --allow-read",
    "type-check": "deno check ."
  },
  "imports": {
    "@playwright/test": "npm:@playwright/test@^1.62.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "chrome-launcher": "npm:chrome-launcher@^1.2.1",
    "lighthouse": "npm:lighthouse@^13.4.1",
    "opentype.js": "npm:opentype.js@^2.0.0",
    "zod": "npm:zod@^4.5.4",
    "$common/": "../common/"
  },
  "fmt": {
    "lineWidth": 240,
    "semiColons": false,
    "singleQuote": true
  }
}
